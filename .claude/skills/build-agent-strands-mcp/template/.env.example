# The model the agent will use.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# Gateway on your host? Put its URL here. No gateway? DELETE this line; an empty value breaks the client.
OPENAI_BASE_URL=

# Where Splunk Agent Observability traces will be sent. 
SPLUNK_AO_CONSOLE_URL=https://console.multitenant.sao.splunkcloud.com
SPLUNK_AO_API_URL=https://api.multitenant.sao.splunkcloud.com
SPLUNK_AO_API_KEY=
SPLUNK_AO_PROJECT=
SPLUNK_AO_AGENT_STREAM=${INSTANCE}

# Planted failure for demos. One of: none | wrong_tool | ambiguous_tools | stale_result |
# pii_leak | latency | injection_success. Default is set by the build skill from the brief.
FAILURE_MODE=none

# Agent Control (step 6, control path). The key is your SPLUNK_AO_API_KEY. Ask the facilitator for the URL for your tenant.
AGENT_CONTROL_URL="https://console.multitenant.sao.splunkcloud.com/api/agent-control"
AGENT_CONTROL_AGENT_NAME="agent-${INSTANCE}"
AGENT_CONTROL_API_KEY_HEADER="Splunk-AO-API-Key"
AGENT_CONTROL_RUNTIME_AUTH_MODE="jwt"
AGENT_CONTROL_TARGET_TYPE="log_stream"
