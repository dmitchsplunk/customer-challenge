# Model for the agent. On the workshop host OPENAI_API_KEY and OPENAI_BASE_URL
# are already set. Do not put those values in this file. The endpoint serves
# gpt-4.1-mini; set OPENAI_MODEL only to override that default.
OPENAI_MODEL=gpt-4.1-mini

# Planted failure for demos. One of: none | wrong_tool | ambiguous_tools | stale_result |
# pii_leak | latency | injection_success. Default is set by the build skill from the brief.
FAILURE_MODE=none

# Agent Control. Do not put an API key in this file. The host already has one.
AGENT_CONTROL_URL="https://console.multitenant.sao.splunkcloud.com/api/agent-control"
AGENT_CONTROL_AGENT_NAME="agent-control-example"
AGENT_CONTROL_API_KEY_HEADER="Splunk-AO-API-Key"
AGENT_CONTROL_RUNTIME_AUTH_MODE="jwt"
AGENT_CONTROL_TARGET_TYPE="log_stream"
