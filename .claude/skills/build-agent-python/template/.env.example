# The model the agent will use.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=provided_by_facilitator 
OPENAI_BASE_URL=provided_by_facilitator

# Where Splunk Agent Observability traces will be sent. 
SPLUNK_AO_CONSOLE_URL=https://console.multitenant.sao.splunkcloud.com 
SPLUNK_AO_API_URL=https://api.multitenant.sao.splunkcloud.com
SPLUNK_AO_API_KEY=provided_by_facilitator 
SPLUNK_AO_PROJECT=provided_by_facilitator
SPLUNK_AO_AGENT_STREAM=$INSTANCE

# Planted failure for demos. One of: none | fabricated_citation | pii_leak | wrong_tool |
# injection_success | latency | wrong_category. Default is set by the build skill from the brief.
FAILURE_MODE=none

# Agent Control. Do not put an API key in this file. The host already has one.
AGENT_CONTROL_URL="https://console.multitenant.sao.splunkcloud.com/api/agent-control"
AGENT_CONTROL_AGENT_NAME="agent-control-example"
AGENT_CONTROL_API_KEY_HEADER="Splunk-AO-API-Key"
AGENT_CONTROL_RUNTIME_AUTH_MODE="jwt"
AGENT_CONTROL_TARGET_TYPE="log_stream"
